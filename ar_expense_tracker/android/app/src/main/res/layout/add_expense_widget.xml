<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:padding="0dp">

    <LinearLayout
        android:id="@+id/widget_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/widget_bg_m3"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:clipToOutline="true">

        <!-- 1. Header Bar: Book Badge on Left, Accessible Quick Add FAB on Right -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Active Book Pill -->
            <LinearLayout
                android:id="@+id/widget_book_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/widget_pill_m3"
                android:paddingStart="10dp"
                android:paddingEnd="12dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp">

                <ImageView
                    android:id="@+id/widget_book_icon"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_marginEnd="6dp"
                    android:src="@drawable/ic_wallet_m3"
                    android:contentDescription="Book" />

                <TextView
                    android:id="@+id/widget_group_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Expense Tracker"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Daily Average Pill (Tapping opens Insights) -->
            <LinearLayout
                android:id="@+id/widget_daily_avg_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/widget_pill_m3"
                android:paddingStart="10dp"
                android:paddingEnd="12dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:contentDescription="Daily Average">

                <ImageView
                    android:id="@+id/widget_daily_avg_icon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="6dp"
                    android:src="@drawable/ic_trending_m3"
                    android:contentDescription="Insights" />

                <TextView
                    android:id="@+id/widget_daily_avg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Avg: ₹0"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1" />
            </LinearLayout>
        </LinearLayout>

        <!-- 2. Hero Expenditure & Budget Tracking -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="5dp">

            <TextView
                android:id="@+id/widget_amount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="₹0.00"
                android:textColor="@color/widget_text_primary"
                android:textSize="32sp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="20sp"
                android:autoSizeMaxTextSize="36sp" />

            <!-- Budget Progress Bar (Visible when budget configured) -->
            <ProgressBar
                android:id="@+id/widget_budget_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:minHeight="5dp"
                android:maxHeight="5dp"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/widget_progress_track"
                android:visibility="gone" />

            <!-- Budget Status & Transactions Row -->
            <LinearLayout
                android:id="@+id/widget_budget_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="3dp">

                <TextView
                    android:id="@+id/widget_budget_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text=""
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <!-- Transaction Count Pill Badge -->
                <LinearLayout
                    android:id="@+id/widget_tx_chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/widget_pill_m3"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:layout_marginStart="6dp">

                    <TextView
                        android:id="@+id/widget_tx_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 txns"
                        android:textColor="@color/widget_text_secondary"
                        android:textSize="10sp"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 3. Bottom Row: Recent Activity (Expanded Left) & Thumb Quick Add FAB (Right Corner) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false">

            <!-- Card: Recent Activity (Tapping opens Book) -->
            <LinearLayout
                android:id="@+id/widget_bottom_right_card"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:background="@drawable/widget_card_m3"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:orientation="vertical"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="2dp">

                    <ImageView
                        android:id="@+id/widget_recent_icon"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginEnd="5dp"
                        android:src="@drawable/ic_clock_m3"
                        android:contentDescription="Recent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RECENT"
                        android:textColor="@color/widget_text_secondary"
                        android:textSize="10sp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.05" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/widget_last_expense_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="@color/widget_text_tertiary"
                        android:textSize="10sp"
                        android:fontFamily="sans-serif"
                        android:maxLines="1" />
                </LinearLayout>

                <!-- Row for Name and Amount -->
                <LinearLayout
                    android:id="@+id/widget_last_expense_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/widget_last_expense_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text=""
                        android:textColor="@color/widget_text_primary"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/widget_last_expense_amount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text=""
                        android:textColor="@color/widget_text_primary"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium"
                        android:includeFontPadding="false"
                        android:maxLines="1" />
                </LinearLayout>

                <!-- Fallback when no expenses recorded -->
                <TextView
                    android:id="@+id/widget_last_expense_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No expenses yet"
                    android:textColor="@color/widget_text_tertiary"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Thumb Quick Add Action Button (Right Corner: 48x48dp) -->
            <FrameLayout
                android:id="@+id/widget_add_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center_vertical"
                android:contentDescription="Quick add expense">

                <!-- Fallback Circle FAB -->
                <FrameLayout
                    android:id="@+id/widget_fallback_fab"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:background="@drawable/widget_pill_m3">

                    <ImageView
                        android:id="@+id/widget_fallback_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_add"
                        android:contentDescription="Add Expense" />
                </FrameLayout>

                <!-- Dynamic Bitmap Shape FAB -->
                <ImageView
                    android:id="@+id/widget_bitmap_fab"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:scaleType="fitCenter"
                    android:visibility="gone"
                    android:contentDescription="Add Expense" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
